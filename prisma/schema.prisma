// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  CLASS_TEACHER
  PARENT
  STUDENT
  ACCOUNTANT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  APPROVED_LEAVE
}

enum GradeLevelBand {
  EARLY_YEARS // Nursery, LKG, UKG
  PRIMARY     // Classes 1-5
  MIDDLE      // Classes 6-8
  SECONDARY   // Classes 9-10
}

model School {
  id            String           @id @default(uuid())
  name          String
  code          String           @unique
  district      String?
  state         String?
  affiliationNo String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  academicYears AcademicYear[]
  users         User[]
  classes       Class[]
  students      StudentProfile[]
  teachers      TeacherProfile[]
  auditLogs     AuditLog[]
}

model User {
  id             String          @id @default(uuid())
  schoolId       String
  name           String
  email          String          @unique
  passwordHash   String
  role           Role
  isActive       Boolean         @default(true)
  school         School          @relation(fields: [schoolId], references: [id])
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  guardians      GuardianLink[]
  auditLogs      AuditLog[]

  @@index([schoolId, role])
}

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   // e.g., "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  school    School   @relation(fields: [schoolId], references: [id])
  classes   Class[]
}

model Class {
  id             String                     @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String                     // e.g., "Class 10"
  section        String                     // e.g., "A"
  band           GradeLevelBand
  school         School                     @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear               @relation(fields: [academicYearId], references: [id])
  students       StudentProfile[]
  subjectConfigs SubjectTeacherAssignment[]
  attendance     AttendanceSession[]

  @@unique([schoolId, academicYearId, name, section])
}

model StudentProfile {
  id           String             @id @default(uuid())
  schoolId     String
  userId       String             @unique
  classId      String
  rollNumber   String
  admissionNo  String?
  dob          DateTime
  school       School             @relation(fields: [schoolId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  class        Class              @relation(fields: [classId], references: [id])
  guardians    GuardianLink[]
  attendance   AttendanceRecord[]
  marks        MarkRecord[]

  @@index([schoolId, classId])
}

model TeacherProfile {
  id          String                     @id @default(uuid())
  schoolId    String
  userId      String                     @unique
  staffId     String
  designation String?
  school      School                     @relation(fields: [schoolId], references: [id])
  user        User                       @relation(fields: [userId], references: [id])
  assignments SubjectTeacherAssignment[]

  @@index([schoolId])
}

model GuardianLink {
  id        String         @id @default(uuid())
  parentId  String
  studentId String
  relation  String?        // e.g., "Father", "Mother", "Legal Guardian"
  parent    User           @relation(fields: [parentId], references: [id])
  student   StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model SubjectTeacherAssignment {
  id        String         @id @default(uuid())
  classId   String
  teacherId String
  subject   String
  class     Class          @relation(fields: [classId], references: [id])
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
}

model AttendanceSession {
  id        String             @id @default(uuid())
  classId   String
  date      DateTime           @db.Date
  period    Int?               // Null for daily attendance, populated for period-wise
  takenById String
  createdAt DateTime           @default(now())
  class     Class              @relation(fields: [classId], references: [id])
  records   AttendanceRecord[]

  @@unique([classId, date, period])
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  remarks   String?
  session   AttendanceSession @relation(fields: [sessionId], references: [id])
  student   StudentProfile    @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

model HomeworkAssignment {
  id          String   @id @default(uuid())
  schoolId    String
  classId     String
  subject     String
  title       String
  description String
  isActivity  Boolean  @default(false) // Early years developmental activity flag
  attachments String[] // Storage URLs
  dueDate     DateTime
  createdAt   DateTime @default(now())
}

model MarkRecord {
  id            String         @id @default(uuid())
  studentId     String
  subject       String
  assessment    String         // e.g., "Term 1 Exam", "Observation Milestone"
  marksObtained Float
  maxMarks      Float
  grade         String?
  remarks       String?
  student       StudentProfile @relation(fields: [studentId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String
  actorId   String
  action    String
  target    String
  payload   Json
  timestamp DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id])
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([schoolId, timestamp])
}
